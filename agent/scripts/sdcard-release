#!/bin/sh
set -eu

LOCKDIR=/run/sdmux-sdcard

[ -d "$LOCKDIR" ] || {
    echo "SD card is not acquired"
    exit 1
}

MNT="$(cat "$LOCKDIR/mountpoint")"
DEV="$(cat "$LOCKDIR/dev")"

sync

if mountpoint -q "$MNT"; then
    umount "$MNT"
fi

blockdev --flushbufs "$DEV" 2>/dev/null || true

sdmux dut

rmdir "$MNT" 2>/dev/null || true
rm -rf "$LOCKDIR"

echo "SD card released to DUT"
