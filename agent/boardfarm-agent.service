[Unit]
Description=Boardfarm Hardware Agent
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=boardfarm
WorkingDirectory=/opt/boardfarm/agent
ExecStart=/opt/boardfarm/agent/venv/bin/uvicorn agent.main:app --host 0.0.0.0 --port 8766
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

# Needed for mDNS (zeroconf)
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
