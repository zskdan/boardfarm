#!/bin/sh
set -eu
# Mount or unmount a device's SD card via the agent host.
#
# Reads AGENT_HOST, DEVICE_ID and SDMUX_CONTROL from the environment.
# Set them in your shell profile or inline:
#
#   export AGENT_HOST=vivado@192.168.1.5
#   export DEVICE_ID=DEV-A3F9C1
#   export SDMUX_CONTROL=/dev/usb/hidraw0
#   sdcard open
#
# Or inline:
#   AGENT_HOST=vivado@192.168.1.5 DEVICE_ID=DEV-A3F9C1 SDMUX_CONTROL=/dev/usb/hidraw0 sdcard open

AGENT_HOST="${AGENT_HOST:?AGENT_HOST env var required (e.g. vivado@192.168.1.5)}"
DEVICE_ID="${DEVICE_ID:?DEVICE_ID env var required (e.g. DEV-A3F9C1)}"
SDMUX_CONTROL="${SDMUX_CONTROL:?SDMUX_CONTROL env var required (e.g. /dev/usb/hidraw0)}"
ACTION="${1:?Usage: $0 open|close|status}"

LOCAL_MNT="$HOME/sdcard-${DEVICE_ID}"

case "$ACTION" in
  open)
    mkdir -p "$LOCAL_MNT"
    REMOTE_MNT="$(ssh "$AGENT_HOST" sudo /opt/boardfarm/agent/sdcard-manager open "$SDMUX_CONTROL" | tail -n 1)"
    sshfs "$AGENT_HOST:$REMOTE_MNT" "$LOCAL_MNT" \
      -o reconnect \
      -o ServerAliveInterval=15 \
      -o ServerAliveCountMax=3
    echo "SD card available at $LOCAL_MNT"
    ;;

  close)
    if mountpoint -q "$LOCAL_MNT" 2>/dev/null; then
      fusermount -u "$LOCAL_MNT" 2>/dev/null || fusermount3 -u "$LOCAL_MNT"
    fi
    ssh "$AGENT_HOST" sudo /opt/boardfarm/agent/sdcard-manager close
    echo "SD card released to DUT"
    ;;

  status)
    if mountpoint -q "$LOCAL_MNT" 2>/dev/null; then
      echo "open — mounted at $LOCAL_MNT"
    else
      echo "closed"
    fi
    ;;

  *)
    echo "Usage: AGENT_HOST=... DEVICE_ID=... SDMUX_CONTROL=... $0 open|close|status" >&2
    exit 1
    ;;
esac
