#!/bin/sh
set -eu
# SD card manager for boardfarm agent.
# Called via SSH by the sdcard user script.
#
# Usage:
#   sdcard-manager open <sdmux_control_device>
#   sdcard-manager close
#   sdcard-manager status

ACTION="${1:?Usage: $0 open <sdmux_control_device> | close | status}"

LOCKDIR=/run/sdmux-sdcard
MNT=/mnt/sdmux-sdcard
BYPATH_GLOB="/dev/disk/by-path/*usb*"

case "$ACTION" in
  open)
    SDMUX_DEV="${2:?Usage: $0 open <sdmux_control_device>}"

    mkdir "$LOCKDIR" 2>/dev/null || {
        echo "SD card already acquired"
        exit 1
    }

    cleanup() { rm -rf "$LOCKDIR"; }
    trap cleanup EXIT INT TERM

    usbsdmux "$SDMUX_DEV" host
    sleep 2

    DEV=""
    for i in $(seq 1 50); do
        DEV="$(ls $BYPATH_GLOB-part* 2>/dev/null | head -n 1 || true)"
        [ -n "$DEV" ] || DEV="$(ls $BYPATH_GLOB 2>/dev/null | grep -v -- '-part' | head -n 1 || true)"
        [ -n "$DEV" ] && break
        sleep 0.1
    done

    [ -n "$DEV" ] || {
        echo "No SD card device found in /dev/disk/by-path"
        exit 1
    }

    mkdir -p "$MNT"
    REAL_DEV="$(readlink -f "$DEV")"

    findmnt -rn -S "$REAL_DEV" -o TARGET | while read -r AUTO_MNT; do
        [ -n "$AUTO_MNT" ] || continue
        echo "WARNING: $REAL_DEV is already mounted at $AUTO_MNT, taking ownership" >&2
        umount "$AUTO_MNT"
    done

    mount "$DEV" "$MNT"
    echo "$REAL_DEV"  > "$LOCKDIR/dev"
    echo "$MNT"       > "$LOCKDIR/mountpoint"
    echo "$SDMUX_DEV" > "$LOCKDIR/sdmux"

    trap - EXIT INT TERM

    echo "$MNT"
    ;;

  close)
    [ -d "$LOCKDIR" ] || {
        echo "SD card is not acquired"
        exit 1
    }

    MNT_PATH="$(cat "$LOCKDIR/mountpoint")"
    DEV="$(cat "$LOCKDIR/dev")"
    SDMUX_DEV="$(cat "$LOCKDIR/sdmux")"

    sync

    if mountpoint -q "$MNT_PATH"; then
        umount "$MNT_PATH"
    fi

    blockdev --flushbufs "$DEV" 2>/dev/null || true

    usbsdmux "$SDMUX_DEV" dut

    rmdir "$MNT_PATH" 2>/dev/null || true
    rm -rf "$LOCKDIR"

    echo "SD card released to DUT"
    ;;

  status)
    if [ -d "$LOCKDIR" ]; then
        MNT_PATH="$(cat "$LOCKDIR/mountpoint" 2>/dev/null || echo unknown)"
        echo "open — mounted at $MNT_PATH"
    else
        echo "closed"
    fi
    ;;

  *)
    echo "Usage: $0 open <sdmux_control_device> | close | status" >&2
    exit 1
    ;;
esac
